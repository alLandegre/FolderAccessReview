<Window x:Class="NeFs.AclAuditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NeFs.AclAuditor.ViewModels"
        xmlns:models="clr-namespace:NeFs.AclAuditor.Core.Models;assembly=NeFs.AclAuditor.Core"
        Title="Folder Access Review"
        Height="720" Width="1180"
        MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">
  <Window.DataContext>
    <vm:MainViewModel />
  </Window.DataContext>

  <DockPanel Margin="12">
    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Background="White" Padding="12" CornerRadius="6" Margin="0,0,0,10"
            BorderBrush="#D0D7DE" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Путь:" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}"
                 VerticalContentAlignment="Center" Height="28" Margin="0,0,8,0"/>
        <Button Grid.Row="0" Grid.Column="2" Content="Обзор…" Command="{Binding BrowseCommand}"
                Width="80" Height="28" Margin="0,0,8,0"/>
        <TextBlock Grid.Row="0" Grid.Column="3" Text="Глубина:" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding Depth, UpdateSourceTrigger=PropertyChanged}"
                 Width="48" Height="28" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
        <Button Grid.Row="0" Grid.Column="5" Content="Сканировать" Command="{Binding ScanCommand}"
                Width="110" Height="28" Margin="0,0,8,0" FontWeight="SemiBold"/>
        <Button Grid.Row="0" Grid.Column="6" Content="Отмена" Command="{Binding CancelCommand}"
                Width="80" Height="28"/>

        <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="7" Margin="0,10,0,0">
          <Button DockPanel.Dock="Right" Content="Экспорт…" Command="{Binding ExportCommand}"
                  Width="100" Height="28" Margin="8,0,0,0"/>
          <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap"
                     Foreground="#57606A"/>
        </DockPanel>
      </Grid>
    </Border>

    <!-- Status counts -->
    <Border DockPanel.Dock="Bottom" Padding="4,8,4,0">
      <TextBlock Foreground="#57606A">
        <Run Text="Папок:"/>
        <Run Text="{Binding FolderCount, Mode=OneWay}"/>
        <Run Text="  |  Ошибок:"/>
        <Run Text="{Binding ErrorCount, Mode=OneWay}"/>
        <Run Text="  |  Только чтение ACL (без изменения прав)"/>
      </TextBlock>
    </Border>

    <TabControl BorderThickness="0" Background="Transparent">
      <TabItem Header="Сканирование">
        <!-- Main split -->
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="240"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="400"/>
          </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="White" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Папки" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <CheckBox DockPanel.Dock="Top" Content="Только папки с явными ACE"
                    IsChecked="{Binding OnlyFoldersWithExplicit}" Margin="0,0,0,8"/>
          <TreeView ItemsSource="{Binding TreeNodes}"
                    SelectedItemChanged="TreeView_OnSelectedItemChanged"
                    BorderThickness="0"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">
            <TreeView.ItemContainerStyle>
              <Style TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
              </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.Resources>
              <HierarchicalDataTemplate DataType="{x:Type vm:FolderNodeViewModel}" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}">
                  <TextBlock Text="{Binding DisplayLabel}" VerticalAlignment="Center"/>
                  <TextBlock Text=" ⚠" Foreground="#CF222E" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </HierarchicalDataTemplate>
            </TreeView.Resources>
          </TreeView>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

      <Border Grid.Column="2" Background="White" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6" Padding="10">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Права доступа (NTFS ACL)"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedPathDisplay}" Foreground="#57606A"
                       TextWrapping="Wrap" Margin="0,4,0,2"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding AclSummaryText}" Foreground="#57606A"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>
            <WrapPanel>
              <TextBlock Text="Субъект:" VerticalAlignment="Center" Margin="0,0,6,6"/>
              <ComboBox Width="130" Margin="0,0,12,6"
                        ItemsSource="{Binding SubjectFilterOptions}"
                        SelectedItem="{Binding SubjectFilter}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock>
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="{Binding}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Static models:SubjectFilter.All}">
                              <Setter Property="Text" Value="Все"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="{x:Static models:SubjectFilter.Users}">
                              <Setter Property="Text" Value="Пользователи"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="{x:Static models:SubjectFilter.Groups}">
                              <Setter Property="Text" Value="Группы"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock Text="Тип:" VerticalAlignment="Center" Margin="0,0,6,6"/>
              <ComboBox Width="120" Margin="0,0,12,6"
                        ItemsSource="{Binding AceTypeFilterOptions}"
                        SelectedItem="{Binding AceTypeFilter}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock>
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="{Binding}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Static models:AceTypeFilter.All}">
                              <Setter Property="Text" Value="Все"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="{x:Static models:AceTypeFilter.Allow}">
                              <Setter Property="Text" Value="Разрешить"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="{x:Static models:AceTypeFilter.Deny}">
                              <Setter Property="Text" Value="Запретить"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock Text="Наследование:" VerticalAlignment="Center" Margin="0,0,6,6"/>
              <ComboBox Width="150" Margin="0,0,12,6"
                        ItemsSource="{Binding InheritanceFilterOptions}"
                        SelectedItem="{Binding InheritanceFilter}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock>
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="{Binding}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Static models:InheritanceFilter.All}">
                              <Setter Property="Text" Value="Все"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="{x:Static models:InheritanceFilter.ExplicitOnly}">
                              <Setter Property="Text" Value="Только явные"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="{x:Static models:InheritanceFilter.InheritedOnly}">
                              <Setter Property="Text" Value="Только унаследованные"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,6,6"/>
              <TextBox Width="200" Height="26" VerticalContentAlignment="Center" Margin="0,0,0,6"
                       Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            </WrapPanel>
          </DockPanel>

          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" MinHeight="100"/>
              <RowDefinition Height="6"/>
              <RowDefinition Height="180" MinHeight="120"/>
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0"
                      ItemsSource="{Binding FilteredAces}"
                      SelectedItem="{Binding SelectedAce}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F6F8FA"
                      BorderThickness="0"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Субъект" Binding="{Binding Subject}" Width="2*"/>
                <DataGridTextColumn Header="Тип субъекта" Binding="{Binding IdentityKind}" Width="*"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding AceType}" Width="90"/>
                <DataGridTextColumn Header="Наследование" Binding="{Binding Inheritance}" Width="110"/>
                <DataGridTextColumn Header="Уровень" Binding="{Binding Level}" Width="*"/>
                <DataGridTextColumn Header="Примечание" Binding="{Binding Note}" Width="2*"/>
              </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="220"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" BorderBrush="#D0D7DE" BorderThickness="0,1,0,0" Padding="0,8,8,0">
                <DockPanel>
                  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="Сбросить"
                            Command="{Binding ClearSubjectFocusCommand}"
                            Padding="8,2" Margin="8,0,0,0"/>
                    <TextBlock FontWeight="SemiBold" Text="{Binding SubjectFoldersHeader}"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                  </DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="{Binding SubjectFoldersStatus}" Foreground="#57606A"
                             TextWrapping="Wrap" Margin="0,0,0,6"/>
                  <ListBox ItemsSource="{Binding SubjectFolderHits}"
                           SelectedItem="{Binding SelectedSubjectHit}"
                           BorderThickness="0"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,2">
                          <TextBlock Text="{Binding FullPath}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Summary}" Foreground="#57606A" FontSize="11"/>
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Border>

              <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

              <Border Grid.Column="2" BorderBrush="#D0D7DE" BorderThickness="0,1,0,0" Padding="8,8,0,0">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="{Binding MembersHeader}"/>
                  <TextBlock DockPanel.Dock="Top" Text="{Binding MembersStatus}" Foreground="#57606A"
                             TextWrapping="Wrap" Margin="0,4,0,8"/>
                  <TreeView ItemsSource="{Binding GroupMemberNodes}"
                            BorderThickness="0"
                            VirtualizingPanel.IsVirtualizing="True">
                    <TreeView.ItemContainerStyle>
                      <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                      </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.Resources>
                      <HierarchicalDataTemplate DataType="{x:Type vm:GroupMemberNodeViewModel}"
                                                ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                          <TextBlock Text="{Binding KindDisplay}" Foreground="#57606A"/>
                        </StackPanel>
                      </HierarchicalDataTemplate>
                    </TreeView.Resources>
                  </TreeView>
                </DockPanel>
              </Border>
            </Grid>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>
      </TabItem>

      <TabItem Header="Пользователи">
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="240"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="400"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Background="White" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6" Padding="10">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Пользователи с прямыми ACE"/>
              <TextBlock DockPanel.Dock="Top" Text="{Binding UsersStatus}" Foreground="#57606A"
                         TextWrapping="Wrap" Margin="0,4,0,8" FontSize="11"/>

              <Border DockPanel.Dock="Top" Background="#F6F8FA" BorderBrush="#D0D7DE" BorderThickness="1"
                      CornerRadius="4" Padding="8" Margin="0,0,0,8">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Папка базы данных"/>
                  <TextBlock DockPanel.Dock="Top" Text="{Binding DbPathDisplay}" Foreground="#57606A"
                             TextWrapping="Wrap" Margin="0,4,0,6" FontSize="11"/>
                  <WrapPanel>
                    <Button Content="Обзор…" Command="{Binding BrowseDbFolderCommand}"
                            Padding="8,2" Margin="0,0,6,0"/>
                    <Button Content="ProgramData (общая)" Command="{Binding UseSharedDbFolderCommand}"
                            Padding="8,2" Margin="0,0,6,0"
                            ToolTip="{Binding RecommendedSharedDbFolder}"/>
                    <Button Content="По умолчанию" Command="{Binding ResetDbFolderCommand}"
                            Padding="8,2"/>
                  </WrapPanel>
                </DockPanel>
              </Border>

              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Обновить" Command="{Binding RefreshUsersCommand}"
                        Padding="8,2" Margin="8,0,0,0"/>
                <TextBox Height="26" VerticalContentAlignment="Center"
                         Text="{Binding UserSearchText, UpdateSourceTrigger=PropertyChanged}"/>
              </DockPanel>
              <CheckBox DockPanel.Dock="Top" Content="Показывать неактивные (снятые) права"
                        IsChecked="{Binding ShowInactiveGrants}" Margin="0,0,0,8"/>
              <ListBox ItemsSource="{Binding StoredUsers}"
                       SelectedItem="{Binding SelectedStoredUser}"
                       BorderThickness="0"
                       DisplayMemberPath="Summary"/>
            </DockPanel>
          </Border>

          <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

          <Border Grid.Column="2" Background="White" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6" Padding="10">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold"
                         Text="Прямые доступы выбранного пользователя"/>
              <TextBlock DockPanel.Dock="Top" Foreground="#57606A" Margin="0,4,0,8" TextWrapping="Wrap"
                         Text="Только персональные ACE (не через группы). Удобно искать забытые временные права."/>
              <DataGrid ItemsSource="{Binding StoredGrants}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal"
                        AlternatingRowBackground="#F6F8FA"
                        BorderThickness="0">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Папка" Binding="{Binding FolderPath}" Width="3*"/>
                  <DataGridTextColumn Header="Тип" Binding="{Binding AceType}" Width="90"/>
                  <DataGridTextColumn Header="Уровень" Binding="{Binding Level}" Width="*"/>
                  <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
                  <DataGridTextColumn Header="Впервые" Binding="{Binding FirstSeen}" Width="110"/>
                  <DataGridTextColumn Header="Последний раз" Binding="{Binding LastSeen}" Width="110"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
